{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=securechat.db"
  },
  "Jwt": {
    "Issuer": "SecureChat",
    "Audience": "SecureChatClient",
    "SecretKey": "REPLACE_WITH_USER_SECRETS",
    "ExpirationDays": 7
  },
  "BCrypt": { "WorkFactor": 12 },
  "Cors": {
    "AllowedOrigins": [ "http://localhost", "https://localhost" ]
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": { "path": "logs/log-.txt", "rollingInterval": "Day" }
      }
    ]
  }
}

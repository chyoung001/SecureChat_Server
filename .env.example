# ================================================================
# SecureChat 백엔드 환경 변수 템플릿
# ================================================================
# 이 파일을 복사해서 .env를 만들고 실제 값을 채우세요.
#   cp .env.example .env
# ================================================================

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://localhost:7001;http://localhost:5001

JWT_SECRET_KEY=YOUR_SECRET_KEY_HERE
JWT_ISSUER=SecureChat
JWT_AUDIENCE=SecureChatClient
JWT_EXPIRATION_DAYS=7

DB_CONNECTION_STRING=Data Source=securechat.db

BCRYPT_WORK_FACTOR=12

CORS_ALLOWED_ORIGINS=http://localhost,https://localhost

SERILOG_MIN_LEVEL=Information
SERILOG_LOG_PATH=logs/log-.txt
